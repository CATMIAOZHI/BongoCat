# 复制成 .env 再填（.env 已在 .gitignore 里忽略，不要提交）。
#
# 多会话：这台服务器同时服务很多对用户。凭据分三种，作用完全不同：
#
#   1. 服务器密码（下面必填的那项）：决定**谁能用这台服务器**。所有客户端都填同一个值。
#   2. 配对密码：每一对用户自己的凭据（客户端里「生成配对密码」现造一个），
#      填同一个值的两个人进入同一个双人会话。服务器管理员不需要为任何人创建它。
#   3. 公益密码（可选，见文件末尾）：决定**谁能借这台服务器打洞**，但只打洞、
#      不转发任何数据、不广告 TURN。想把自己的服务器开放给更多人就设它。

# 服务器密码（必填）：没有它，任何知道这台服务器地址的人都能白用你的转发与 TURN
# 凭据。至少 16 个字符，随便什么文本都行（生一个：
# `cargo run --release --bin generate-pair -- --server`）。
# 填完把它发给每一位要用这台服务器的人，他们填在客户端的「服务器密码」里。
# **可以写多把**（用 `;` 分隔），每把各给一个人：换人时只撤销那一把，别人的不受影响。
# 例：PAIR_SERVER_PASSWORD=alice-的密码;bob-的密码
# 注意：分号是分隔符，密码里**不要**写分号。
PAIR_SERVER_PASSWORD=

# 同时承载的双人会话数（每组最多两台设备）。满了只拒绝**新的**会话，已经在跑的
# 不受影响；一组人全都退出后名额立刻释放。
# 1GB 内存的机器请调到个位数（比如 4），2GB 可以留 10~20——理由见 README 的内存说明。
PAIR_MAX_SESSIONS=20

# 监听地址。默认就够用；**域名模式不要改成 127.0.0.1:8080**——Caddy 是从另一个
# 容器连 `relay:8080` 的，改完它连不上上游（502），而健康检查照样是 healthy。
# **端口也别改**：域名模式要同时改 Caddy 的上游，direct 模式要同时改
# docker-compose.direct.yml 里的 `ports`（那边是写死的 8080）；只改这里会让容器
# 监听一个端口、宿主发布另一个端口，客户端连不上而健康检查照样 healthy。
# PAIR_LISTEN=0.0.0.0:8080

# 想放开额度（例如为了客户端 60Hz）时改这几行；不给就是 CF 的 30 / 20 / 12MiB——
# 但 docker compose 默认把帧那一项给到 90（客户端推出 60Hz），所以「不给」时实际是 90。
# 客户端按 2/3 推导自己的速率：广告 90 → 客户端 60。
# （这几项都由 docker compose 透传给容器；`.env` 本身容器不读。下面注释掉的那几行
#   想改就取消注释，别在别处另写一份。）
PAIR_MAX_FRAMES_PER_SECOND=90
# PAIR_MAX_CHUNKS_PER_SECOND=20
# PAIR_MAX_BYTES_PER_SECOND=12582912
# PAIR_STALE_AFTER_MS=120000

# 内置 STUN 的 UDP 端口（默认 3479，一般不用改）。它告诉每个客户端「你的公网地址
# 是多少」，P2P 直连全靠它；安全组要放行这个 UDP 端口。端口被占时换一个空闲的即可
# （compose 的端口映射会跟着变）。想关掉就设 0，但**必须先**把 compose 里 `ports`
# 的那行 udp 注释掉，否则 compose 会因为 `0:0/udp` 起不来。
# PAIR_STUN_PORT=3479

# 可选：自建 coturn 后把地址广告给客户端（coturn 本体是 docker-compose.coturn.yml，
# 这个值填在这里、由主 compose 透传）。**填了它就以它为准，内置 STUN 不启动**——
# 所以这里要把 STUN 和 TURN 都写上。只有「两个人都在运营商大内网、STUN 也打不通」
# 时才需要 TURN；一般留空、用内置 STUN 就够了。
# 只会广告给**通过服务器密码**的连接，所以不用担心凭据被陌生人拿走。
# **不要加引号**（compose 文件里才需要引号），整行一次写完。
# PAIR_ICE_SERVERS=[{"urls":["stun:cat.example.com:3478"]}]

# ── 公益档（可选，默认关闭）──────────────────────────────────────────────
# 设了公益密码，别人就能拿它借你这台服务器**打洞**：那一路只转发打洞信令与保活，
# 不转发聊天 / 附件 / 语音 / 统计，也**不广告 TURN**（TURN 是按流量计费的）。
# 公益档有自己的名额与额度，占不到你 PAIR_SERVER_PASSWORD 那一档的任何东西。
#
# 怎么用：把下面的密码发给愿意帮忙打洞的人，他们填在客户端的「服务器密码」里。
# 他们那边界面会显示「公益档」，并且在直连建立之前发不出消息（那是设计如此）。
# 生一串：`cargo run --release --bin generate-pair -- --server`
# 至少 16 个字符，而且**不能**和 PAIR_SERVER_PASSWORD 相同（两把不同的钥匙）。
# **也可以写多把**（用 `;` 分隔）：几个人就发几把，谁不用了删掉他那把即可。
# 例：PAIR_PUBLIC_SERVER_PASSWORD=公益-1;公益-2（分号是分隔符，密码里不要写分号）
# PAIR_PUBLIC_SERVER_PASSWORD=

# 公益档同时承载的会话数（默认 10）。0 = 实际关闭：服务器照常启动、只打一条提醒，
# 但那一档会表现得像「没有公益档」——拿着公益密码的人连不上（403 密码不对），
# `/health` 也报 `publicTier:false`。适合「暂时关掉、密码先留着」。
# PAIR_MAX_PUBLIC_SESSIONS=10

# 同一个 IP 最多同时开几组公益会话（默认 4，一条会话是两条连接，也就是两对）。
# 只挡**新建会话**：同一个 NAT 下面的一对人不会被自己挡住。0 = 不限。
# PAIR_MAX_PUBLIC_PER_IP=4

# 公益档一条连接的**持续**额度（默认 12 帧/秒、8 KiB/秒）——这是**回填速率**，不是「一次
# 能发多少」。诚实形状是它唯一的依据：一组一轮打洞是 hello + offer/answer + 逐条的 candidate
# （约 12 帧 / 8 KB），一次发完，然后长时间静默（打不通时按 5→120 秒退避重试，整夜也就
# 0.2~1.6 KB/秒）。所以它还有 5~35 倍余量，而「拿信令帧夹带数据」被压到 28 MB/小时这个量级。
# 帧那一维客户端也会看到：它按广告值的 2/3 推自己的出站速率（12 → 8 帧/秒）。
# PAIR_PUBLIC_MAX_FRAMES_PER_SECOND=12
# PAIR_PUBLIC_MAX_BYTES_PER_SECOND=8192

# 公益档一条连接的**突发容量**（默认 24 帧、64 KiB）。令牌桶的容量与回填速率必须是两个数：
# 只用一个数（容量 = 1 秒的量）就只能二选一——小到装不下一轮打洞，或者大到等于没有上限
# （「256 KiB/秒」实际是「256 KiB 的突发」，一小时能灌 900 MB）。给足突发、压低持续。
# PAIR_PUBLIC_BURST_FRAMES=24
# PAIR_PUBLIC_BURST_BYTES=65536

# 公益档**每把钥匙**的滚动预算（默认 16 MiB，设 0 = 不设这一层）。它管的是「一把钥匙
# 一共能过多少数据」：一次性 16 MiB，之后每小时回填 16 MiB。**额度用完是限速，不是断开**：
# 中继会等到这一帧装得下再转发（回填速度就是速度上限），只有「等不起」才用 4006 关掉那条
# 连接——也就是这一帧比整份额度还大、或者 5 秒内等不到。5 秒这个数是迁就客户端的
# 10 秒单次发送超时：等过去客户端会先以「发送超时」重启会话，原因反而看不见。
# 诚实用法每把钥匙约 0.8 MB/小时（整夜打不通那种极端值），20 倍余量；夹带者最坏也只能
# 「先花 16 MiB，之后 16 MiB/小时」。
# 记账挂**钥匙**而不是连接 / 房间 / IP：房间是客户端用配对密码推出来的（换个配对密码就是
# 新房间，一空就被清掉），IP 会连坐同一个 NAT、在 IPv6 上还很软——只有钥匙是发出去的、
# 拿钥匙的人换不掉。**运营规则：一把钥匙一个人**，共用一把等于共用这份预算。
# PAIR_PUBLIC_KEY_BUDGET_BYTES=16777216

# 握手层每个 IP 每分钟允许几次**失败**（默认 30，设 0 = 不限）。它**按 IP 算、两档都算**
# （拿错服务器密码、拿错公益密码、公益名额满……都记一笔）：拿错密码刷 /ws 的代价本来
# 只是一次摘要比较，真正会被打爆的是**日志**（排障的唯一证据，被刷掉就等于没有）。
# 超过之后这个 IP 直接 429，并且不再写日志。诚实客户端碰不到它：密码不对在客户端是
# 「致命的」，它直接提示你改密码、不重试；会按退避重试的是 429 / 503 那一类，退避封顶
# 30 秒 = 最多 2 次/分钟，离 30 次/分钟差十几倍。代价：同一个 NAT 后面有人一直在刷时，
# 同网段的无辜用户也会被 429 一段时间（最长约一分钟：欠账有下界，刷得再久也只是
# 「继续被封」，不会累加成几小时）。
# PAIR_HANDSHAKE_FAILURES_PER_MINUTE=30

# 公益档的空闲回收窗口（默认 180 秒，0 = 不回收）。**它不是「打洞截止时间」**：
# 中继看不到直连有没有打通（信令是密文），所以它判的是「多久没收到任何入站消息」。
# 客户端每 60 秒发一次心跳，180 秒 = 三次漏拍。
# PAIR_PUBLIC_WINDOW_SECS=180

# 同一把服务器钥匙最多同时开几组会话（默认 4，0 = 不限）。**两档共用**这一条：一对用户
# 只有一组会话，所以 4 是「重连重叠也够」的余量；它挡的是「一把发出去的钥匙把整档名额
# 吃光」。撞上它拿到 429，换一把钥匙即可。
# PAIR_MAX_SESSIONS_PER_KEY=4

# ── 完全档（你自己那一档）的护栏 ─────────────────────────────────────────
# 它们都不影响正常使用，决定的是「一把服务器密码泄漏之后最坏能怎样」。
#
# 完全档的空闲回收窗口（默认 300 秒，0 = 不回收）：判据与公益档那条完全一样（多久没
# 收到任何入站消息），关闭码也共用 4005。它清的是**僵尸连接**——对端机器睡眠、网线被
# 拔之后 TCP 可能几小时都不报错，那条什么都没在传的连接会一直占着会话名额。
# PAIR_FULL_WINDOW_SECS=300

# 完全档**每把钥匙**的滚动预算（默认 2 GiB，0 = 不设这一层）：一次性花掉 2 GiB，之后
# 每小时回填 2 GiB。额度用完同样是**限速**（中继等到装得下再转发），只有「等不起」才用
# 4006 关掉那条连接。与公益档那一份是同一套记账（都挂在钥匙上），只是额度大得多——这一档
# 要承载聊天 / 语音 / 附件分片。2 GiB/小时 ≈ 4.7 Mbit/s 持续，对诚实用法是隐形的。
# **别配得太小**：一个 512 KiB 的附件分片要在 5 秒的等待上限内等到额度，回填速度
# 至少要约 105 KiB/s，也就是这一项别低于约 400 MiB（默认 2 GiB = 596 KiB/s）。
#
# 限速期间有一个看得见的副作用（只在这条连接**走中继**时，也就是还没直连或直连不可用时）：
# 正在传大文件时，排在大分片**后面**的桌宠快照会一起变慢（默认约 0.9 秒，贴着 400 MiB
# 下限时约 4.5 秒）。对方猫那边按键高亮的 TTL 是 800ms，所以
# 「按着键 + 同时传大文件 + 额度正好花光」三件事凑齐时，对方猫那只按住的键可能掉一下再亮
# 起来。那是慢，不是断线也不是丢帧；把这一项配大就不容易碰到。直连（DC）那条腿在的时候
# 桌宠快照与附件分片都优先走它，不跟中继上的大分片排队。
# PAIR_FULL_KEY_BUDGET_BYTES=2147483648

# ── 限时 TURN 凭据（可选，推荐）──────────────────────────────────────────
# PAIR_ICE_SERVERS 里那份 TURN 凭据是**长期有效**的：一旦出现在日志 / 聊天记录 /
# 截图里，别人就能一直拿它打（流量算你的）。填上 PAIR_TURN_SECRET（必须和 coturn 的
# static-auth-secret 写**同一个值**，生一个：`openssl rand -hex 32`）之后，中继会在
# 每次连接时现签一份限时凭据放进 welcome，默认 24 小时过期；客户端**零改动**。
# coturn 侧同时要把 turnserver.conf 里的 lt-cred-mech 与 user= 换成
# use-auth-secret + static-auth-secret=<同一个值>（这两组是**互斥**的）。
# 留空 = 用 PAIR_ICE_SERVERS 里那份静态凭据（旧行为）。
# PAIR_TURN_SECRET=
# PAIR_TURN_TTL_SECS=86400

# 信不信 X-Forwarded-For（默认关闭）。只在前面站着**可信反代**时打开：
# docker-compose.yml（Caddy）已经默认给 1；direct 模式那份 compose **写死 0**，
# 因为那里对端就是客户端本身，打开只会让私网里的对端伪造这个头、把「每 IP 限额」绕过去。
# 打开时中继取这个头**所有行里的最后一项**（反代追加的才是真的），同时仓库里的
# Caddyfile 用 `header_up X-Forwarded-For {remote_host}` 把这一项钉成替换，两层各管一段。
# PAIR_TRUST_PROXY=1

# 使用域名 + Caddy（推荐，自动 HTTPS）时填写；用 docker-compose.direct.yml 的
# 裸 IP 模式时不需要。**留空**，让 compose 在自己报出「请先在 .env 里设置
# PAIR_DOMAIN」——填个占位域名会让它先启动成功、再在 ACME 里反复失败。
PAIR_DOMAIN=
